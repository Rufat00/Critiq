{
  "name": "critiq",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @critiq/db run generate",
    "db:validate": "pnpm --filter @critiq/db run validate",
    "db:migrate": "pnpm --filter @critiq/db run migrate",
    "db:deploy": "pnpm --filter @critiq/db run deploy",
    "db:studio": "pnpm --filter @critiq/db run studio",
    "db:seed": "pnpm --filter @critiq/db run seed",
    "db:check": "pnpm --filter @critiq/db run check",
    "dev": "pnpm --filter @critiq/web dev",
    "build": "pnpm --filter @critiq/web build",
    "start": "pnpm --filter @critiq/web start",
    "test:judging": "node --import ./packages/db/node_modules/tsx/dist/loader.mjs --test packages/core/src/judging/**/*.test.ts",
    "test:judging:integration": "node --import ./packages/db/node_modules/tsx/dist/loader.mjs packages/db/scripts/test-judging.ts",
    "judging:npc": "node --env-file-if-exists=.env --import ./packages/db/node_modules/tsx/dist/loader.mjs packages/core/scripts/run-npc-judges.ts",
    "test:judging:npc": "node --import ./packages/db/node_modules/tsx/dist/loader.mjs packages/db/scripts/test-judging.ts --npc",
    "judging:reset": "node --env-file-if-exists=.env --import ./packages/db/node_modules/tsx/dist/loader.mjs packages/core/scripts/reset-development-judging.ts"
  },
  "devDependencies": {
    "prettier": "3.8.4",
    "typescript": "5.9.3"
  }
}
