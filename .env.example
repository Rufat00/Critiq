# Development defaults only. Docker Compose reads the root .env automatically.
DB_NAME=critiq
DB_USER=critiq
DB_PASSWORD=critiq_dev
DB_PORT=5432

# For Prisma and app processes running on the host.
DATABASE_URL=postgresql://critiq:critiq_dev@localhost:5432/critiq?schema=public

# Shared application URL for authentication and email links.
# Authentication: generate a unique secret with `openssl rand -base64 32`.
AUTH_SECRET=
APP_URL=http://localhost:3000

# Local Mailpit SMTP: no authentication or TLS required.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Critiq <noreply@critiq.test>"
MAILPIT_UI_PORT=8025

# Production: set DB_NAME, DB_USER, and a unique DB_PASSWORD in the deployment
# environment. A containerized app uses postgres:5432 rather than localhost.
# Keep DATABASE_URL consistent with the database credentials and hostname.

# Standalone @critiq/mail configuration; not yet connected to authentication.
# Explicit opt-out: skips delivery and reduces security when integrated with auth.
# No silent fallback occurs when a provider fails or configuration is missing.
NO_EMAIL_LOWER_SECURITY_MODE=false

# Choose exactly one: EMAIL_HOST (SMTP) or SENDGRID_API_KEY (HTTPS API).
# Local Mailpit defaults; production SMTP defaults to 587 with required STARTTLS.
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_REQUIRE_TLS=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
SENDGRID_API_KEY=
EMAIL_FROM=noreply@critiq.test
# Optional sender-name override; defaults to the hackathon name or Critiq Judging.
EMAIL_FROM_NAME=
