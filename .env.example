# Development defaults only. Docker Compose reads the root .env automatically.
DB_NAME=critiq
DB_USER=critiq
DB_PASSWORD=critiq_dev
DB_PORT=5432

# For Prisma and app processes running on the host.
DATABASE_URL=postgresql://critiq:critiq_dev@localhost:5432/critiq?schema=public

# Used only when db:seed creates the first hackathon.
HACKATHON_NAME="Critiq Hackathon"

# Production: set DB_NAME, DB_USER, and a unique DB_PASSWORD in the deployment
# environment. A containerized app uses postgres:5432 rather than localhost.
# Keep DATABASE_URL consistent with the database credentials and hostname.
