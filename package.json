{
  "name": "critiq",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f compose.dev.yaml up -d",
    "db:down": "docker compose -f compose.dev.yaml down",
    "db:logs": "docker compose -f compose.dev.yaml logs -f postgres",
    "db:generate": "pnpm --filter @critiq/db run generate",
    "db:validate": "pnpm --filter @critiq/db run validate",
    "db:migrate": "pnpm --filter @critiq/db run migrate",
    "db:deploy": "pnpm --filter @critiq/db run deploy",
    "db:status": "pnpm --filter @critiq/db run status",
    "db:studio": "pnpm --filter @critiq/db run studio",
    "db:seed": "pnpm --filter @critiq/db run seed",
    "db:check": "pnpm --filter @critiq/db run check"
  },
  "devDependencies": {
    "prettier": "3.8.4",
    "typescript": "5.9.3"
  }
}
